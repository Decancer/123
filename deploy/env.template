# 生产环境变量模板
# 复制为 .env 并填入实际值

# ===== 数据库 =====
DATABASE_URL="file:./dev.db"

# ===== JWT 密钥（生成命令：openssl rand -base64 64）=====
JWT_SECRET="在此填入生成的64位随机字符串"

# ===== Resend 邮件 API Key =====
RESEND_API_KEY="RESEND_KEY_REDACTED"

# ===== 网站地址（邮箱验证链接用）=====
# 开发环境：http://localhost:3000
# 生产环境（有IP无域名）：http://<服务器IP>:3000
# 生产环境（有域名）：https://your-domain.com
BASE_URL="http://localhost:3000"

# ===== 运行环境 =====
NODE_ENV="production"
